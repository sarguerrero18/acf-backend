# Copiar como .env y completar con los valores reales.
# NUNCA versionar el archivo .env real - son secretos.

# URL base del modulo ORDS 'actas' del schema ACF (sin endpoint ni
# query string). *** confirmar si ACF vive en el mismo host/instancia
# de Autonomous Database que usa formula-engine (GTH) -- si es la
# misma, solo cambia /ords/gth/... por /ords/acf/... en la URL.
ORDS_BASE_URL=https://xxxxxxxxxxxx.adb.sa-bogota-1.oraclecloudapps.com/ords/acf/actas

# Credenciales OAuth2 client_credentials del cliente acf_backend_client
# (ver migrations/02_ords_protect_oauth2.sql, que las genera):
#   SELECT client_id, client_secret FROM user_ords_clients
#   WHERE name = 'acf_backend_client';
ORDS_CLIENT_ID=
ORDS_CLIENT_SECRET=

# Opcional: si el endpoint de token no se puede derivar automaticamente
# de ORDS_BASE_URL (caso normal: https://host/ords/acf/oauth/token),
# se puede fijar explicito aqui.
#ORDS_TOKEN_URL=https://xxxxxxxxxxxx.adb.sa-bogota-1.oraclecloudapps.com/ords/acf/oauth/token

# Multi-tenant: mismo criterio que formula-engine, si algun endpoint
# necesita CLIENTE_ID/ENTIDAD_ID explicitos por venir de un proceso sin
# sesion APEX.
CLIENTE_ID=
ENTIDAD_ID=

# Puerto del servidor HTTP (src/server.ts). Opcional, default 3001
# (distinto del 3000 que usa formula-engine, por si ambos corren en
# la misma maquina en algun momento, ej. en desarrollo local).
#PORT=3001

# Nota: las rutas protegidas (todo bajo /actas/*) validan el Bearer
# token de APEX contra ORDS (mismo mecanismo que verificarTokenApex.ts
# en formula-engine) - no requiere variables de entorno nuevas en Node
# para esa validacion. El cliente OAuth2 que usa APEX (acf_apex_client)
# se crea con migrations/03_ords_apex_client.sql y sus credenciales se
# configuran del lado de APEX (Web Credential ACF_APEX_OAUTH2 en el
# Workspace GEN), no aqui.
